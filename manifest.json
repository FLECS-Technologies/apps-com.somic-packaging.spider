{
    "$schema": "https://raw.githubusercontent.com/FLECS-Technologies/app-sdk/3.0.0/manifest.schema.json",
    "_schemaVersion": "3.0.0",
    "app": "com.somic-packaging.spider",
    "version": "##VERSION##",
    "revision": "0",
    "image": "flecs.azurecr.io/com.somic-packaging.spider",
    "multiInstance": false,
    "editors": [
        {
            "name": "Somic Spider",
            "port": 6700,
            "supportsReverseProxy": false
        }
    ],
    "env": [
        "HOST=127.0.0.1",
        "PORT=6700",
        "MTX_HOST=127.0.0.1",
        "MTX_PORT=9997",
        "RTSP_PORT=8554",
        "HLS_PORT=8888",
        "DEBUG=false",
        "LOG_LEVEL=info",
        "LOG_FORMAT=json",
        "CLIPS_DIR=./clips",
        "CLIP_MAX_AGE=2h",
        "CLIP_CLEAN_INTERVAL=15m",
        "DB_FILE=./data/db.json",
        "MAX_CAMS=7",
        "MAX_STREAMS=3",
        "MAX_BUFFER=60"
    ],
    "ports": [
        "6700:6700",
        "8554:8554",
        "8888:8888"
    ],
    "volumes": [
        "/home/somic/app/spider/:/app/data"
    ]
}
