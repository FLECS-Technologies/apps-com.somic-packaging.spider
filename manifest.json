{
    "$schema": "https://raw.githubusercontent.com/FLECS-Technologies/app-sdk/3.0.0/manifest.schema.json",
    "_schemaVersion": "3.0.0",
    "app": "com.somic-packaging.spider",
    "version": "##VERSION##",
    "revision": "0",
    "image": "flecs.azurecr.io/com.somic-packaging.spider",
    "multiInstance": false,
    "editors": [
        {
            "name": "Somic Spider",
            "port": 6700,
            "supportsReverseProxy": false
        }
    ],
    "env": [
        "API_HOST=127.0.0.1",
        "API_PORT=6700",
        "MEDIAMTX_API=http://localhost:9997",
        "MEDIAMTX_RTSP=rtsp://localhost:8554",
        "MEDIAMTX_HLS=http://localhost:8888",
        "SAVE_FILE=./data/db.json",
        "CAMERA_LIMIT=10",
        "STREAM_LIMIT=5",
        "MAX_BUFFER_DURATION=60"
    ],
    "ports": [
        "6700:6700",
        "8554:8554",
        "8888:8888"
    ],
    "volumes": [
        "/home/somic/app/spider/:/app/data"
    ]
}
